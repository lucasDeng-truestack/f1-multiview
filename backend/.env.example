REDIS_URL=redis://localhost:6379/0
OPENF1_BASE_URL=https://api.openf1.org

# Live auth (free OAuth2 tier: 3 req/s, 30 req/min). Required only inside the
# live window (30 min before session → 30 min after). Leave empty for replay dev.
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Or supply a pre-issued bearer token (skips OAuth exchange):
OPENF1_TOKEN=

POLL_INTERVAL_MS=5000
TIMING_POLL_INTERVAL_MS=4000
TRACK_POLL_INTERVAL_MS=4000
CORS_ORIGINS=http://localhost:3000

# Replay is the default dev path (free historical OpenF1 data, no auth).
REPLAY_MODE=true
REPLAY_SESSION_KEY=9165
REPLAY_STEP_SECONDS=60
